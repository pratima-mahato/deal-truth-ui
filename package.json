{
  "name": "deal-truth-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Deal Truth — evidence-backed call intelligence. No proof in the transcript, no claim in the report.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "screenshot:demo": "playwright test e2e/screenshot.spec.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down --remove-orphans",
    "design": "open design/prototype.html || xdg-open design/prototype.html",
    "parity": "playwright test e2e/parity.spec.ts",
    "check:brand": "! grep -ril 'open.\\?gong' src index.html README.md e2e package.json LICENSE",
    "check": "npm run typecheck && npm run lint && npm test && npm run check:brand && npm run parity"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.85.5",
    "lucide-react": "^0.542.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^18.3.1",
    "react-router-dom": "^7.8.2",
    "recharts": "^3.1.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "msw": "^2.11.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
