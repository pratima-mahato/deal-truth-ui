# Deal Truth API origin
# Local example: http://localhost:8000
# Production (Vite build-time, optional): https://deal-truth-api.onrender.com
VITE_API_BASE_URL=

VITE_USE_MOCKS=false

VITE_DEMO_CALL_ID=call-acme-saas-labs

# Optional API key sent as X-API-Key from the browser.
# Visible in the client bundle — do not put production secrets here.
# On Render, set API_KEY on the container instead (nginx adds the header).
VITE_API_KEY=

# HubSpot/Slack integration service origin. The browser calls
# {origin}/v1/hubspot and {origin}/health. Never put HubSpot tokens or Slack
# webhooks here — those stay on the integration service.
# Example: http://localhost:4001
VITE_INTEGRATION_API_BASE_URL=

# Integration service API token. Sent as Authorization: Bearer.
# Visible in the Vite client bundle — do not put a production token here.
# On Docker/Render, set INTEGRATION_API_TOKEN instead (nginx adds the header).
VITE_INTEGRATION_API_TOKEN=

# Independent of VITE_USE_MOCKS. Defaults to on when the origin above is empty.
VITE_USE_MOCK_INTEGRATIONS=

# Required only when using an ngrok endpoint
# VITE_NGROK_SKIP_BROWSER_WARNING=true

# Integration service origin (HubSpot + Slack). Leave empty to use the in-app mock.
# Example: https://integrations.example.com
VITE_INTEGRATION_API_BASE_URL=

# When true, HubSpot/Slack calls stay in-app (no tokens, no webhook URLs).
# Defaults to true when VITE_INTEGRATION_API_BASE_URL is empty.
VITE_USE_MOCK_INTEGRATIONS=true

# --- Render / Docker runtime (not used by Vite) ---
# PORT=10000
# API_UPSTREAM=
# API_BASE_URL=
# API_KEY=
# INTEGRATION_UPSTREAM=http://host.docker.internal:4001
# INTEGRATION_API_BASE_URL=
# INTEGRATION_API_TOKEN=
# UPLOAD_MAX_BODY_SIZE=100m
