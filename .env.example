# Deal Truth API origin
# Local example: http://localhost:8000
# Production (Vite build-time, optional): https://deal-truth-api.onrender.com
VITE_API_BASE_URL=

VITE_USE_MOCKS=false

VITE_DEMO_CALL_ID=call-acme-saas-labs

# Optional API key sent as X-API-Key from the browser.
# Visible in the client bundle — do not put production secrets here.
# On Render, set API_KEY on the container instead (nginx adds the header).
VITE_API_KEY=

# Required only when using an ngrok endpoint
# VITE_NGROK_SKIP_BROWSER_WARNING=true

# --- Render / Docker runtime (not used by Vite) ---
# PORT=10000
# API_UPSTREAM=https://deal-truth-api.onrender.com
# API_BASE_URL=
# API_KEY=
# UPLOAD_MAX_BODY_SIZE=100m
