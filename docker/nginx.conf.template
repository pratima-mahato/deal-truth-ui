daemon off;
user nginx;
worker_processes auto;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;

events {
  worker_connections 1024;
}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  server_tokens off;

  access_log /dev/stdout;

  sendfile on;
  tcp_nopush on;
  tcp_nodelay on;
  keepalive_timeout 65;

  client_max_body_size __UPLOAD_MAX_BODY_SIZE__;
  client_body_timeout 120s;

  gzip on;
  gzip_comp_level 5;
  gzip_min_length 256;
  gzip_proxied any;
  gzip_vary on;
  gzip_types
    text/plain
    text/css
    text/javascript
    application/javascript
    application/json
    application/xml
    image/svg+xml;

  map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    "" $scheme;
  }

  server {
    listen 0.0.0.0:__LISTEN_PORT__;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    include /etc/nginx/snippets/security-headers.conf;

    location = /healthz {
      access_log off;
      add_header Content-Type text/plain;
      return 200 "ok\n";
    }

    location = /index.html {
      expires -1;
      add_header Cache-Control "no-store";
      include /etc/nginx/snippets/security-headers.conf;
    }

    location = /config.js {
      expires -1;
      add_header Cache-Control "no-store";
      include /etc/nginx/snippets/security-headers.conf;
    }

    location /assets/ {
      expires 1y;
      add_header Cache-Control "public, immutable";
      include /etc/nginx/snippets/security-headers.conf;
    }

    __API_LOCATION__

    location / {
      try_files $uri $uri/ /index.html;
    }
  }
}
